{
  "name": "photo-portfolio",
  "version": "0.1.0",
  "homepage": "https://photo.gsme.dev",
  "private": true,
  "dependencies": {
    "@react-three/drei": "^9.121.4",
    "@react-three/fiber": "^8.17.14",
    "@react-three/postprocessing": "^2.19.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.64",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "classnames": "^2.3.2",
    "framer-motion": "^10.16.5",
    "maath": "^0.10.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "three": "^0.173.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "photos:optimize": "python3 localimages/scripts/photo_assets.py",
    "photos:pages": "python3 scripts/page-studio/server.py",
    "photos:publish": "python3 scripts/prepare-public-photos.py",
    "scene:bake": "python3 scripts/bake-three-scene.py",
    "scene:check": "python3 -m unittest discover -s scripts -p 'test_three_scene.py'",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "react-scripts start",
    "prestart": "npm run scene:bake && npm run photos:publish",
    "prebuild": "npm run scene:bake && npm run photos:publish",
    "build": "node scripts/build-production.cjs",
    "postbuild": "python3 scripts/prepare-public-photos.py --build && node scripts/verify-scene-build.cjs && python3 scripts/prepare-public-photos.py --check-build",
    "preview": "node scripts/preview.cjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^6.1.0",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.10",
    "sass": "^1.69.5",
    "tailwindcss": "^3.4.0"
  }
}
